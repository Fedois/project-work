// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  LIBRARIAN
  ADMIN
}

enum ReservationStatus {
  PENDING // In attesa di approvazione
  APPROVED // Approvata, libro può essere ritirato
  FULFILLED // Libro ritirato
  REJECTED // Rifiutata dal bibliotecario
  CANCELLED // Annullata dall'utente
}

enum Category {
  FANTASY
  THRILLER
  HORROR
  DRAMA
  COMEDY
  ACTION
  ADVENTURE
  SCI_FI
  MYSTERY
  ROMANCE
  BUSINESS
  OTHER
}

model User {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String        @unique
  role         UserRole      @default(MEMBER)
  loans        Loan[]
  reservations Reservation[]
  feedbacks    Feedback[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Book {
  id              String        @id @default(cuid())
  title           String
  author          String
  isbn            String?       @unique
  coverImagePath  String?
  publicationDate DateTime      
  quantity        Int           @default(1)
  category        Category
  loans           Loan[]
  reservations    Reservation[]
  feedbacks       Feedback[]
  description     String?
  pages           Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([title])
}

model Loan {
  id         String    @id @default(cuid())
  loanDate   DateTime  @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())

  @@index([userId, returnedAt])
  @@index([bookId, returnedAt])
  @@index([dueDate, returnedAt])
}

model Reservation {
  id        String            @id @default(cuid())
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookId    String
  book      Book              @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([userId, status])
  @@index([bookId, status])
}

model Feedback {
  id          String   @id @default(cuid())
  rating      Int
  title       String?
  comment     String?
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([bookId])
  @@index([userId])
}
